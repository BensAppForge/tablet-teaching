rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teachers can read/write their own teacher profile
    match /teachers/{teacherId} {
      allow read, write: if request.auth != null && request.auth.uid == teacherId;
    }

    // Tests collection. Reads are scoped:
    //   - The owning teacher can read all of their own tests.
    //   - A managed student can read a test if it's assigned to their
    //     class (the student's classId custom claim must be present in
    //     the test's assignedClassIds list). Their list query MUST
    //     include `where("assignedClassIds", "array-contains", classId)`
    //     for the rule to be satisfiable.
    //   - Anonymous Schnellzugang users can read any test — they
    //     arrived via a quickCodes/{code} lookup that bound them to a
    //     specific test, and the worksheet itself re-checks testId
    //     against their quickAttempts doc.
    match /tests/{testId} {
      allow read: if request.auth != null && (
        resource.data.teacherId == request.auth.uid ||
        (
          request.auth.token.role == 'student' &&
          resource.data.get('assignedClassIds', []).hasAny([request.auth.token.classId])
        ) ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
      allow create, update: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/tests/$(testId)).data.teacherId == request.auth.uid;
    }

    // Questions are subcollections of tests.
    // Reads are open to any signed-in user so students can render the
    // worksheet. TODO: tighten with class-assignment rules once
    // tests get an `assignedClassIds` field — for now any authenticated
    // user (teacher or student) can read any test's questions.
    match /tests/{testId}/questions/{questionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/tests/$(testId)).data.teacherId == request.auth.uid;
    }

    // Student submissions, subcollection of each test.
    //   - Managed students (role == 'student') can create a submission
    //     for themselves, but only on a test that is assigned to their
    //     class. Schnellzugang (anonymous) submissions are NOT persisted
    //     — kids using a quick code don't have a class claim, so the
    //     create rule rejects them by design.
    //   - The owning teacher can read all submissions and delete any.
    //   - A student can read their own submission(s) — needed so the
    //     worksheet treats Firestore as source of truth: if the teacher
    //     deletes a result, the student's review state clears on next
    //     load. Queries must include where("studentId", "==", uid) for
    //     the rule to allow listing.
    //   - Submissions are write-once: no updates.
    match /tests/{testId}/submissions/{submissionId} {
      allow create: if request.auth != null
        && request.auth.token.role == 'student'
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.classId == request.auth.token.classId
        && get(/databases/$(database)/documents/tests/$(testId)).data.assignedClassIds.hasAny([request.auth.token.classId]);
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/tests/$(testId)).data.teacherId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/tests/$(testId)).data.teacherId == request.auth.uid;
      allow update: if false;
    }

    // Classes: teacher-owned grouping of students.
    // Reads allowed for the owning teacher OR for a student whose
    // custom-claim classId matches this doc (so a student can render
    // their own class name on the dashboard without a Firestore lookup
    // chain in the rule).
    match /classes/{classId} {
      allow read: if request.auth != null && (
        resource.data.teacherId == request.auth.uid ||
        (request.auth.token.role == 'student' && request.auth.token.classId == classId)
      );
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Students: doc id is the student's Firebase Auth uid.
    // - The owning teacher can read/write.
    // - The student themselves can read their own doc (to discover their classId).
    // Student auth users are created by a Cloud Function with the Admin SDK;
    // teachers do not write to these documents through client SDKs in v1.
    match /students/{studentUid} {
      allow read: if request.auth != null &&
        (request.auth.uid == studentUid || resource.data.teacherId == request.auth.uid);
      allow write: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Attempts and distributions are intentionally locked down until the
    // student flow is designed. The previous `if true` rules allowed anyone
    // to read/write/delete arbitrary documents.
    match /attempts/{attemptId} {
      allow read, write: if false;
    }

    match /distributions/{code} {
      allow read, write: if false;
    }

    // Schnellzugang code → test lookup. Reads open to any signed-in
    // user (so anonymous students can resolve a code to a testId);
    // writes restricted to the owning teacher.
    match /quickCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Per-anonymous-attempt record. The doc id IS the anonymous user's
    // uid, so a student can only ever read or write their own attempt.
    // The scheduled Cloud Function uses the Admin SDK (bypasses rules)
    // to delete expired attempts together with their auth users.
    match /quickAttempts/{attemptId} {
      allow read, write: if request.auth != null && request.auth.uid == attemptId;
    }
  }
}