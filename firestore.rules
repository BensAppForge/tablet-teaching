rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teachers can read their own profile and maintain its plain fields.
    // The privilege flags (isPremium, isBetaTester, premiumExpiresOn) are
    // server-managed: the Cloud Functions AI quota trusts them, so they
    // must never be client-writable. Signup may create the doc only with
    // both flags false; updates must not touch them (Admin SDK only).
    match /teachers/{teacherId} {
      allow read: if request.auth != null && request.auth.uid == teacherId;
      // CLOSED BETA: self-service teacher signup is disabled. New beta
      // testers are onboarded manually (create the teachers/{uid} doc with
      // the Admin SDK / console). Re-enable by restoring the create rule
      // below — the flags-must-be-false guard is preserved in a comment.
      //   allow create: if request.auth != null && request.auth.uid == teacherId
      //     && request.resource.data.get('isPremium', false) == false
      //     && request.resource.data.get('isBetaTester', false) == false
      //     && !request.resource.data.keys().hasAny(['premiumExpiresOn']);
      allow create: if false;
      allow update: if request.auth != null && request.auth.uid == teacherId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isPremium', 'isBetaTester', 'premiumExpiresOn']);
      allow delete: if false;
    }

    // Tests collection. Reads are scoped:
    //   - The owning teacher can read all of their own tests.
    //   - A managed student can read a test if it's assigned to their
    //     class (the student's classId custom claim must be present in
    //     the test's assignedClassIds list). Their list query MUST
    //     include `where("assignedClassIds", "array-contains", classId)`
    //     for the rule to be satisfiable.
    //   - Anonymous Schnellzugang users can `get` only the single test
    //     their quickAttempts/{uid} doc binds them to. They must never
    //     satisfy `list` — a resource-independent anonymous clause would
    //     let any signInAnonymously() caller dump every teacher's tests.
    match /tests/{testId} {
      allow get: if request.auth != null && (
        resource.data.teacherId == request.auth.uid ||
        (
          request.auth.token.role == 'student' &&
          resource.data.get('assignedClassIds', []).hasAny([request.auth.token.classId])
        ) ||
        (
          request.auth.token.firebase.sign_in_provider == 'anonymous' &&
          get(/databases/$(database)/documents/quickAttempts/$(request.auth.uid)).data.testId == testId
        )
      );
      allow list: if request.auth != null && (
        resource.data.teacherId == request.auth.uid ||
        (
          request.auth.token.role == 'student' &&
          resource.data.get('assignedClassIds', []).hasAny([request.auth.token.classId])
        )
      );
      // Only real teachers (doc in /teachers) may create, only as themselves.
      // Without the exists() check a managed student could create a test
      // owned by their own uid and assign it to their class.
      allow create: if request.auth != null
        && request.resource.data.teacherId == request.auth.uid
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
      // Update requires CURRENT ownership and teacherId is immutable.
      // Checking request.resource.data alone would let any teacher hijack
      // a test by writing their own uid into teacherId.
      allow update: if request.auth != null
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Questions are subcollections of tests and contain the correct
    // answers, so reads are gated exactly like the parent test: owner,
    // class-assigned student, or the bound Schnellzugang user.
    match /tests/{testId}/questions/{questionId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/tests/$(testId)).data.teacherId == request.auth.uid ||
        (
          request.auth.token.role == 'student' &&
          get(/databases/$(database)/documents/tests/$(testId)).data.get('assignedClassIds', []).hasAny([request.auth.token.classId])
        ) ||
        (
          request.auth.token.firebase.sign_in_provider == 'anonymous' &&
          get(/databases/$(database)/documents/quickAttempts/$(request.auth.uid)).data.testId == testId
        )
      );
      allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/tests/$(testId)).data.teacherId == request.auth.uid;
    }

    // Student submissions, subcollection of each test.
    //   - Managed students (role == 'student') can create a submission
    //     for themselves, but only on a test that is assigned to their
    //     class. Schnellzugang (anonymous) submissions are NOT persisted
    //     — kids using a quick code don't have a class claim, so the
    //     create rule rejects them by design.
    //   - Scores are graded client-side, so the rule at least enforces
    //     shape and range (earned within [0, possible]); teachers should
    //     still treat scores as student-asserted.
    //   - The owning teacher can read all submissions and delete any.
    //   - A student can read their own submission(s) — needed so the
    //     worksheet treats Firestore as source of truth: if the teacher
    //     deletes a result, the student's review state clears on next
    //     load. Queries must include where("studentId", "==", uid) for
    //     the rule to allow listing.
    //   - Submissions are write-once: no updates.
    match /tests/{testId}/submissions/{submissionId} {
      allow create: if request.auth != null
        && request.auth.token.role == 'student'
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.classId == request.auth.token.classId
        && get(/databases/$(database)/documents/tests/$(testId)).data.assignedClassIds.hasAny([request.auth.token.classId])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.totalEarned is number
        && request.resource.data.totalPossible is number
        && request.resource.data.totalEarned >= 0
        && request.resource.data.totalEarned <= request.resource.data.totalPossible
        && request.resource.data.perQuestion is map;
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/tests/$(testId)).data.teacherId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/tests/$(testId)).data.teacherId == request.auth.uid;
      allow update: if false;
    }

    // Collections: teacher-owned virtual folders for organising tests.
    // Pure display metadata (name); the test↔collection link lives on the
    // test's `collectionId` field, governed by the /tests update rule.
    // Strictly owner-only — no student ever reads these.
    match /collections/{collectionId} {
      function validColor() {
        return request.resource.data.get('color', 'blue')
          in ['blue', 'green', 'purple', 'rose', 'amber', 'teal'];
      }
      allow read: if request.auth != null && resource.data.teacherId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && validColor();
      // teacherId is immutable; name stays bounded; colour stays in the set.
      allow update: if request.auth != null
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && validColor();
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Schnellzugang (anonymous) results. Unlike managed submissions these
    // are created by anonymous users — but ONLY when the teacher has turned
    // on retention for the test (quickResultsRetention != 'off'), and only
    // by the anonymous user actually bound to this test via their
    // quickAttempts doc. expiresAt is required, must be in the future, and
    // is capped at ~25h so a client can't request long-term storage.
    // Self-typed names, so the teacher should treat identities as asserted.
    match /tests/{testId}/quickSubmissions/{submissionId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && get(/databases/$(database)/documents/quickAttempts/$(request.auth.uid)).data.testId == testId
        && get(/databases/$(database)/documents/tests/$(testId)).data.get('quickResultsRetention', 'off') != 'off'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.totalEarned is number
        && request.resource.data.totalPossible is number
        && request.resource.data.totalEarned >= 0
        && request.resource.data.totalEarned <= request.resource.data.totalPossible
        && request.resource.data.perQuestion is map
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h');
      // Teacher-only reads/deletes; students never read quick results back
      // (the worksheet review state is local-only for anonymous kids).
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/tests/$(testId)).data.teacherId == request.auth.uid;
      allow update: if false;
    }

    // Classes: teacher-owned grouping of students.
    // Reads allowed for the owning teacher OR for a student whose
    // custom-claim classId matches this doc (so a student can render
    // their own class name on the dashboard without a Firestore lookup
    // chain in the rule).
    match /classes/{classId} {
      allow read: if request.auth != null && (
        resource.data.teacherId == request.auth.uid ||
        (request.auth.token.role == 'student' && request.auth.token.classId == classId)
      );
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Students: doc id is the student's Firebase Auth uid.
    // - The owning teacher can read/write.
    // - The student themselves can read their own doc (to discover their classId).
    // Student auth users are created by a Cloud Function with the Admin SDK;
    // teachers do not write to these documents through client SDKs in v1.
    match /students/{studentUid} {
      allow read: if request.auth != null &&
        (request.auth.uid == studentUid || resource.data.teacherId == request.auth.uid);
      allow write: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Attempts and distributions are intentionally locked down until the
    // student flow is designed. The previous `if true` rules allowed anyone
    // to read/write/delete arbitrary documents.
    match /attempts/{attemptId} {
      allow read, write: if false;
    }

    match /distributions/{code} {
      allow read, write: if false;
    }

    // Schnellzugang code → test lookup. Point lookups (`get`) open to any
    // signed-in user so anonymous students can resolve a code to a testId.
    // `list` stays closed — the client only ever does getDoc(code), and a
    // read rule covering list would let any signed-in user enumerate every
    // active code together with its testId.
    match /quickCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Per-anonymous-attempt record. The doc id IS the anonymous user's
    // uid, so a student can only ever read or write their own attempt.
    // The scheduled Cloud Function uses the Admin SDK (bypasses rules)
    // to delete expired attempts together with their auth users.
    match /quickAttempts/{attemptId} {
      allow read, write: if request.auth != null && request.auth.uid == attemptId;
    }
  }
}
